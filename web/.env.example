# Leave empty for local dev — Vite proxies /api → http://127.0.0.1:8000
# Set this only for production builds.
VITE_API_URL=

# Supabase (Vite uses VITE_* — not NEXT_PUBLIC_*)
# Publishable key (sb_publishable_...) or legacy anon JWT both work as VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here
