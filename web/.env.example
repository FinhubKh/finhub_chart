# Leave empty for local dev — Vite proxies /api → http://127.0.0.1:8000
# Set this to the Cloud Run API URL for production builds.
VITE_API_URL=https://finhub-chart-api-oe2fht4xda-as.a.run.app

# Firebase (Vite uses VITE_* — not NEXT_PUBLIC_*)
# From Firebase console → Project settings → General → Your apps (Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
